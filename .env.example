# ==============================================================================
# PrivateChat — Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# NEVER commit .env containing real secrets or production domains to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------

# Application port (default: 3000)
PORT=3000

# Network host interface binding:
# 0.0.0.0 binds to all local network interfaces (Wi-Fi, Ethernet, VPN)
# 127.0.0.1 restricts access strictly to the local machine (default when TUNNEL_MODE=true)
HOST=0.0.0.0

# When TUNNEL_MODE=true, the server automatically defaults HOST to 127.0.0.1,
# preventing unencrypted HTTP from being reachable over the local Wi-Fi / LAN adapter.
TUNNEL_MODE=false

# Environment mode: development | production | test
NODE_ENV=production

# Set to true for home LAN / Wi-Fi deployments without a TLS certificate (allows HTTP cookies over private IPs)
# Set to false when running behind an HTTPS reverse proxy (enforces Secure flag on authentication cookies)
ALLOW_HTTP_INSECURE_LAN=true

# Persistent data directory path (holds SQLite database and WAL files)
DATA_DIR=./data

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting settings (sliding window in milliseconds and maximum requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Remote and Cross-Origin Allowed Origins (comma-separated):
# Needed if hosting the frontend statically (e.g. GitHub Pages or custom domain)
# Examples:
# ALLOWED_ORIGINS=https://username.github.io,https://chat.myhome.net
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Frontend Build-Time Variables (Optional — for building static clients / GitHub Pages)
# ------------------------------------------------------------------------------

# Base path for Vite assets (e.g. '/privatechat/' for GitHub Pages project sites)
# Default is './' for relative asset resolution
VITE_BASE_PATH=./

# Explicit backend API URL (e.g. 'https://api.yourdomain.com' or 'https://chat.local:3000')
# Leave blank to use same-origin relative URLs (/api/...)
VITE_API_URL=

# Explicit WebSocket URL (e.g. 'wss://api.yourdomain.com/ws' or 'wss://chat.local:3000/ws')
# Leave blank to automatically derive from current window.location or VITE_API_URL
VITE_WS_URL=
